generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id                    String @id @default(cuid())
  fullName              String
  phoneNumber           String
  email                 String?
  address               String
  city                  String
  pincode               String
  orderNote             String?

  totalAmountPaise      Int
  paymentMethod         String @default("PAYU")
  status                String @default("PENDING") // PENDING, PAID, FAILED

  merchantTransactionId String? @unique 
  payuTransactionId     String? @unique 
  payuStatus            String?

  refundStatus          String?  // null -> "REQUESTED" -> "SUCCESS" / "FAILED"
  refundAmount          Int?     // in paise
  disputeStatus         String?  // null -> "OPEN" -> "RESOLVED"

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  items                 OrderItem[]
}

model OrderItem {
  id                    String @id @default(cuid())
  orderId               String
  productId             String
  productTitle          String
  quantity              Int
  priceAtPurchasePaise  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentEvent {
  id           String   @id @default(cuid())
  eventType    String   // "payment" | "refund" | "dispute"
  txnId        String   // merchantTransactionId / merchantTxnId / txn_id
  mihpayid     String?  // PayU's payment ID
  status       String   // "success" | "failure" | "pending"
  amount       String?  // Amount as string (PayU sends it this way)
  source       String   // "webhook" | "redirect"
  rawPayload   String   // Full payload as JSON for audit trail
  processedAt  DateTime @default(now())

  @@index([txnId])
  @@index([mihpayid])
}
